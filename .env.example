# Copy this file to .env and fill in values locally. Never commit .env.
# VITE_ variables become public browser configuration; never put secrets in them.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-auth-domain
VITE_FIREBASE_DATABASE_URL=replace-with-database-url
VITE_FIREBASE_PROJECT_ID=replace-with-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
VITE_FIREBASE_APP_ID=replace-with-app-id

# Server-only values. Keep service-account JSON outside version control.
FIREBASE_SERVICE_ACCOUNT_KEY=./firebase-service-account.json
RESEND_API_KEY=replace-with-resend-api-key
