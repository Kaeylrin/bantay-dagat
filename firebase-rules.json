{
  "rules": {
    ".read": false,
    ".write": false,

    "bantaydagat": {
      "readings": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'ranger')",
        ".write": "auth != null"
      },
      "latest": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'ranger')",
        ".write": "auth != null"
      },
      "alerts": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'ranger')",
        ".write": "auth != null"
      }
    },

    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (auth.uid === $uid && !data.exists()))"
      }
    },

    "loginAttempts": {
      "$email_key": {
        ".read": true,
        ".write": true
      }
    }
  }
}
